// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model User {
  ecnumber  Int    @id
  username  String @unique
  password  String
  usergrade Int

  privilege Privilege @relation(fields: [usergrade], references: [id])
}

model Privilege {
  id   Int    @id @default(autoincrement())
  name String

  users User[]
}

model PlantDetail {
  plantCode String @id @db.VarChar(50)
  plantName String @db.VarChar(50)
}

model ModuleDetail {
  id     Int    @id @default(autoincrement())
  module String @db.VarChar(50)
}

model UserDetail {
  ecnumber Int
  prevcode Int

  @@id([ecnumber, prevcode])
}
